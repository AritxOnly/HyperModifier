<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The app policy picker includes system packages with enabled Activity pages. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <package android:name="org.lsposed.manager" />
        <package android:name="com.android.shell" />
        <package android:name="com.mi.health" />
        <package android:name="com.xiaomi.market" />
        <package android:name="com.xiaomi.smarthome" />
        <package android:name="com.autonavi.minimap" />
        <package android:name="com.xiaomi.vipaccount" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:name=".HyperModifierApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_mhm"
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:theme="@style/AppTheme">
        <provider
            android:name=".ModifierSettingsProvider"
            android:authorities="com.aritxonly.myhypermodifier.settings"
            android:exported="true"
            android:grantUriPermissions="false" />
        <receiver
            android:name=".HookDiagnosticReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.aritxonly.myhypermodifier.HOOK_DIAGNOSTIC" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".SettingsActivity"
            android:icon="@drawable/ic_launcher_mhm"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Settings may invoke this fixed request; ordinary apps may not. -->
        <activity
            android:name=".ManagerLaunchActivity"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".DetailSettingsActivity"
            android:exported="false" />
    </application>
</manifest>
