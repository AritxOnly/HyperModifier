<?xml version="1.0" encoding="utf-8"?>
<ConstraintSet xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <Constraint
        android:id="@id/media_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/qs_media_session_height_expanded"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <Constraint
        android:id="@id/album_art"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="12.500002dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <Constraint
        android:gravity="start"
        android:id="@id/header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/album_art_margin_right"
        android:layout_marginEnd="0dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/header_artist"
        app:layout_constraintEnd_toStartOf="@id/action1"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/album_art"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />
    <Constraint
        android:gravity="start"
        android:id="@id/header_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:alpha="0.8"
        android:textAlignment="viewStart"
        android:layout_marginStart="@dimen/album_art_margin_right"
        android:layout_marginEnd="0dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/action1"
        app:layout_constraintStart_toEndOf="@id/album_art"
        app:layout_constraintTop_toBottomOf="@id/header_title" />
    <Constraint
        android:id="@id/action0"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp" />
    <Constraint
        android:gravity="center"
        android:id="@id/action1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/action2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@id/header_title"
        app:layout_constraintTop_toTopOf="parent" />
    <Constraint
        android:gravity="center"
        android:id="@id/action2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/action3"
        app:layout_constraintStart_toEndOf="@id/action1"
        app:layout_constraintTop_toTopOf="parent" />
    <Constraint
        android:gravity="center"
        android:id="@id/action3"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/action2"
        app:layout_constraintTop_toTopOf="parent" />
    <Constraint
        android:id="@id/media_seamless"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp" />
    <Constraint
        android:id="@id/actions"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp" />
    <Constraint
        android:id="@id/action4"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp" />
    <Constraint
        android:id="@id/media_elapsed_time"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp" />
    <Constraint
        android:id="@id/media_progress_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp" />
    <Constraint
        android:id="@id/media_total_time"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp" />
</ConstraintSet>
